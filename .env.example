# --- PostgreSQL ---
POSTGRES_DB=reviews_db
POSTGRES_USER=reviews_user
POSTGRES_PASSWORD=reviews_password

# --- Сайт: порт на хосте ---
APP_PORT=8000

# --- Общий токен авторизации обработчика (worker → site PATCH/POST) ---
# Сайт и обработчик используют ОДИНАКОВОЕ значение. Также защищает внутренний
# test-API воркера (POST /provider-test, header X-Worker-Token) — кнопка «Проверить».
WORKER_API_TOKEN=YOUR_WORKER_API_TOKEN

# --- Внутренний test-API воркера (кнопка «Проверить» в /admin) ---
# Порт НЕ публикуется на хост; сайт проксирует через DNS review-worker:8001.
# WORKER_TEST_URL указывает сайту адрес воркера (внутри compose-сети).
WORKER_API_PORT=8001
WORKER_TEST_URL=http://review-worker:8001

# --- /admin: демо-RBAC (два токена: полный + read-only демо) ---
# ADMIN_TOKEN — полный доступ (смена провайдера/модели/промпта).
# ADMIN_DEMO_TOKEN — только просмотр (мутации → 403).
# ADMIN_AUTH_ENABLED=false отключает auth (только для локальных тестов).
ADMIN_TOKEN=YOUR_ADMIN_TOKEN
ADMIN_DEMO_TOKEN=YOUR_ADMIN_DEMO_TOKEN
ADMIN_AUTH_ENABLED=true

# --- Логирование: уровень логов сайта и воркера (DEBUG/INFO/WARNING/ERROR) ---
LOG_LEVEL=INFO

# --- Идентичность AI-ответов (имя автора авто-ответа; защита от самозацикливания) ---
AI_AUTHOR_NAME=AI Support

# --- OpenAI / OpenAI-compatible ---
# Используется для провайдера openai (модель и base_url настраиваются в /admin).
OPENAI_API_KEY=

# --- GigaChat (Сбер) ---
GIGACHAT_AUTH_KEY=
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_TOKEN_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Путь к CA-bundle Минцифры; пусто = проверка сертификата отключена (dev/demo).
GIGACHAT_CA_BUNDLE=

# --- Telegram-уведомления оператору (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_CHAT_ID=

# --- Worker: интервал опроса (сек) и порог freshness heartbeat для healthcheck ---
WORKER_POLL_INTERVAL=10
WORKER_HEALTHCHECK_MAX_AGE=60